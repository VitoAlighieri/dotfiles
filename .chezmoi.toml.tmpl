[add]
    secrets = "ignore"

{{ if eq .chezmoi.os "windows" -}}
# Windows: los scripts .ps1 de .chezmoiscripts/ se ejecutan siempre con
# Windows PowerShell 5.1 (viene en todo Windows), sin cargar el profile y
# permitiendo scripts locales. Sin esto, en un Windows recien instalado la
# politica por defecto ("Restricted") bloquea los scripts y el primer
# `chezmoi init --apply` falla.
[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{ end -}}

# Los scripts (winget, profile de PowerShell, variables de entorno, bat,
# VS Code...) viven en .chezmoiscripts/ (ver README).
