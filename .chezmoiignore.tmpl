#============ GLOBAL ============#

# Documentacion y metadatos del repo: no se despliegan al $HOME.
README.md
LICENSE
.vscode

# Nota: .chezmoidata/ y .chezmoiscripts/ los excluye chezmoi
# automaticamente (no hace falta listarlos aqui).

#============ VS CODE ============#
# Solo se gestionan settings.json, keybindings.json y snippets/. El resto de
# ~/.config/Code es estado de cada maquina (sesiones, caches, historial,
# tokens de inicio de sesion...) y NUNCA debe acabar en el repo: con estas
# reglas `chezmoi add` lo rechaza aunque se lo pidas por error.
#
# En Linux, en los estados optout, linked y sync de
# .chezmoitemplates/vscode-linux-state (ver README) no se toca nada de
# ~/.config/Code en este equipo. Se ignora la carpeta entera: asi chezmoi ni
# entra en ella, y las excepciones "!" de abajo no cuentan.
{{- $vscode := "" }}
{{- if ne .chezmoi.os "windows" }}
{{-   $vscode = includeTemplate "vscode-linux-state" . | trim }}
{{- end }}
{{- if has $vscode (list "optout" "linked" "sync") }}
.config/Code
{{- end }}
.config/Code/*
!.config/Code/User
.config/Code/User/*
!.config/Code/User/settings.json
!.config/Code/User/keybindings.json
!.config/Code/User/snippets

#============ LINUX ============#
{{ if eq .chezmoi.os "linux" }}
AppData
.config/powershell
{{ end }}
