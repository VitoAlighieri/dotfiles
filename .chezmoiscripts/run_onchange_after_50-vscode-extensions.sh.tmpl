{{- if and (ne .chezmoi.os "windows") (not (env "WSL_DISTRO_NAME")) -}}
#!/bin/sh
# =====================================================================
# Extensiones de VS Code (Linux)
# ---------------------------------------------------------------------
# En Linux VS Code no lo instalan estos dotfiles; si lo tienes, aqui se
# instalan las extensiones de .chezmoidata/packages.yaml (vscode.extensions)
# que falten, p. ej. el tema Catppuccin que activa settings.json.
# Se reejecuta cuando cambia la lista, cuando `code` pasa a estar en el
# PATH y, si alguna instalacion falla o se interrumpe, en cada
# `chezmoi apply` hasta que funcione (lineas de abajo).
# En WSL no se genera: alli `code` es el VS Code de Windows, cuyas
# extensiones ya instala el script .ps1.
#
# code en el PATH al generar este script: {{ if lookPath "code" }}si{{ else }}no{{ end }}
# reintento pendiente: {{ if stat (joinPath .chezmoi.homeDir ".cache/dotfiles/vscode-extensions.pending") }}{{ now | date "20060102T150405.000000000" }}{{ else }}no{{ end }}
# =====================================================================

marker="$HOME/.cache/dotfiles/vscode-extensions.pending"
if ! command -v code >/dev/null 2>&1; then
    rm -f "$marker"
    exit 0
fi
# Marca de "pendiente" mientras se trabaja: si algo falla o se interrumpe,
# el proximo apply vuelve a ejecutar esto. Solo se quita si todo va bien.
mkdir -p "${marker%/*}" && : > "$marker"

installed=$(code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]')
failed=0

for ext in{{ range .packages.vscode.extensions }} {{ . | quote }}{{ end }}; do
    lower=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    if printf '%s\n' "$installed" | grep -qxF "$lower"; then
        continue
    fi
    echo "[vscode] Instalando $ext ..."
    if ! code --install-extension "$ext" >/dev/null 2>&1; then
        echo "[vscode] No se pudo instalar $ext; se reintentara en el proximo 'chezmoi apply' (a mano: code --install-extension $ext)" >&2
        failed=1
    fi
done

[ "$failed" = 0 ] && rm -f "$marker"
exit 0
{{- end -}}
