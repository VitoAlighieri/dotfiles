{{- if eq .chezmoi.os "windows" -}}
# =====================================================================
# VS Code: datos de usuario en ~/.config/Code (igual que en Linux)
# ---------------------------------------------------------------------
# Por defecto VS Code guarda settings y estado en %APPDATA%\Code. Para que
# use la MISMA config que en Linux (~/.config/Code/User/settings.json) se
# fija VSCODE_APPDATA=~/.config (variable soportada por VS Code: con ella
# usa $VSCODE_APPDATA\Code).
#
# En un equipo donde ya usabas VS Code, ANTES de redirigirlo se copian tus
# datos (sesiones, estado de extensiones, historial, inicios de sesion...)
# a la nueva ruta, sin tocar el original y sin pisar el settings.json que
# gestiona chezmoi. Si VS Code esta abierto no se hace nada: cierralo y
# vuelve a ejecutar `chezmoi apply`.
#
# Es un script `run_` (se ejecuta en cada apply, no `run_onchange_`) para
# poder reintentarse; una vez migrado solo comprueba un marcador y sale.
# =====================================================================

$newBase = Join-Path $HOME '.config'        # valor de VSCODE_APPDATA
$newDir  = Join-Path $newBase 'Code'        # VS Code usara $VSCODE_APPDATA\Code
$oldDir  = Join-Path $env:APPDATA 'Code'    # ubicacion por defecto en Windows
$marker  = Join-Path $newDir '.dotfiles-vscode-migrated'

function Set-VSCodeAppData {
    $current = [Environment]::GetEnvironmentVariable('VSCODE_APPDATA', 'User')
    if ($current -ne $newBase) {
        [Environment]::SetEnvironmentVariable('VSCODE_APPDATA', $newBase, 'User')
        Write-Host ("[vscode] VSCODE_APPDATA = {0}" -f $newBase) -ForegroundColor Green
        Write-Host "[vscode] Reinicia VS Code y las terminales abiertas para que lo usen." -ForegroundColor Green
    }
}

# Ya migrado antes: solo asegurar la variable.
if (Test-Path $marker) {
    Set-VSCodeAppData
    exit 0
}

if (Test-Path $oldDir) {
    if (Get-Process -Name 'Code' -ErrorAction SilentlyContinue) {
        Write-Warning "[vscode] VS Code esta abierto. Cierralo y vuelve a ejecutar 'chezmoi apply' para mover sus datos a ~/.config/Code. Mientras tanto sigue usando %APPDATA%\Code."
        exit 0
    }

    Write-Host ("[vscode] Copiando tus datos de VS Code a {0} (puede tardar un poco)..." -f $newDir) -ForegroundColor Yellow
    # Solo se excluyen caches regenerables. /XC /XN /XO = no tocar ningun
    # fichero que ya exista en el destino (p. ej. el settings.json de chezmoi).
    $caches = @(
        'Cache', 'CachedData', 'CachedExtensionVSIXs', 'CachedProfilesData',
        'Code Cache', 'GPUCache', 'DawnCache', 'DawnGraphiteCache',
        'DawnWebGPUCache', 'Crashpad', 'logs'
    )
    & robocopy $oldDir $newDir /E /XC /XN /XO /XJ /XD @caches /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null
    $rc = $LASTEXITCODE
    if ($rc -ge 8) {
        Write-Warning ("[vscode] La copia ha fallado (robocopy {0}). No se cambia nada; se reintentara en el proximo 'chezmoi apply'." -f $rc)
        exit 0
    }
    Write-Host "[vscode] Datos copiados. El original sigue intacto en %APPDATA%\Code (tus settings anteriores: %APPDATA%\Code\User\settings.json)." -ForegroundColor Green
}

Set-VSCodeAppData
if (-not (Test-Path $newDir)) {
    New-Item -ItemType Directory -Path $newDir -Force | Out-Null
}
New-Item -ItemType File -Path $marker -Force | Out-Null
exit 0
{{- end }}
